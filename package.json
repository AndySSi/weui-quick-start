{
  "name": "weui-vue-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:weui-editor": "pnpm --dir tooling/weui-vscode test",
    "weui:editor:package": "pnpm --dir tooling/weui-vscode run package",
    "weui:editor:install": "pnpm --dir tooling/weui-vscode install:local",
    "create": "node scripts/create.mjs",
    "check:updates": "pnpm outdated"
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "weui": "2.6.26",
    "weui.js": "1.2.28"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "unocss": "66.13.0",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
